{
  "name": "noya",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "noya": "./bin/noya.mjs"
  },
  "scripts": {
    "noya": "node --disable-warning=ExperimentalWarning src/cli.ts",
    "test": "node --disable-warning=ExperimentalWarning --test --test-reporter=spec test/*.test.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.ui.json --noEmit",
    "dev": "npm run build && node --watch --disable-warning=ExperimentalWarning src/web.ts",
    "build": "tsc -p tsconfig.ui.json",
    "start": "node --disable-warning=ExperimentalWarning src/web.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.0.0",
    "@earendil-works/pi-coding-agent": "1.0.0",
    "ajv": "8.17.1",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "typescript": "5.8.3"
  }
}
